{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": false,
    "paths": {
      "phoenix_live_view": ["../deps/phoenix_live_view"],
      "phoenix": ["./js/types/modules/phoenix"],
      "phoenix_html": ["./js/types/modules/phoenix_html"],
      "chartjs-adapter-date-fns": [
        "./js/types/modules/chartjs-adapter-date-fns"
      ]
    }
  },
  "include": ["js/**/*.ts", "js/**/*.d.ts"],
  "exclude": ["node_modules", "vendor", "../deps"]
}
