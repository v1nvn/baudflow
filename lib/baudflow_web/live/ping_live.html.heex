<Layouts.app flash={@flash} active_page={@active_page}>
  <%= if @ping_panel_open do %>
    <!-- Live Ping Diagnostics Panel (open during the run and after, until dismissed) -->
    <section class="pt-6 pb-4">
      <div
        id="ping-viz"
        phx-hook="PingViz"
        phx-update="ignore"
        class="crt-panel"
      >
        <!-- Phase strip: a single PING phase -->
        <div class="crt-phase-strip">
          <span class="crt-phase active">PING</span>
        </div>
        
<!-- Oscilloscope display -->
        <div class="crt-scope">
          <div class="crt-scanlines"></div>
          <canvas id="ping-canvas"></canvas>
          <div class="crt-readout">
            <span id="ping-avg" class="crt-speed-num ping-val">───</span>
            <span class="crt-speed-unit-label">ms avg</span>
          </div>
        </div>
        
<!-- Live stats bar -->
        <div class="crt-stats">
          <div class="crt-stat">
            <span class="crt-stat-label">JITTER</span>
            <span id="ping-jitter" class="crt-stat-value">──</span>
            <span class="crt-stat-unit">ms</span>
          </div>
          <div class="crt-stat">
            <span class="crt-stat-label">LOSS</span>
            <span id="ping-loss" class="crt-stat-value">──</span>
          </div>
          <div class="crt-stat">
            <span class="crt-stat-label">ELAPSED</span>
            <span id="ping-elapsed" class="crt-stat-value">──</span>
            <span class="crt-stat-unit">s</span>
          </div>
          <div class="crt-stat">
            <span class="crt-stat-label">TARGET</span>
            <span id="ping-target" class="crt-stat-value">──</span>
          </div>
        </div>
      </div>
      
<!-- Controls row: spinner while running, Run Again + Close once complete -->
      <div class="flex items-center justify-end mt-4 gap-2">
        <%= if @test_running do %>
          <button id="run-ping-btn" class="cta-run" disabled={true}>
            <span class="inline-block size-4 border-2 border-white/30 border-t-white rounded-full animate-spin">
            </span>
            Running...
          </button>
        <% else %>
          <button id="run-again-btn" phx-click="run_ping" class="cta-run">
            <.icon name="hero-arrow-path-mini" class="size-4" /> Run Again
          </button>
          <button
            id="close-ping-panel"
            phx-click="close_ping_panel"
            class="bf-btn-ghost px-3 py-2 text-sm rounded-lg text-text-dim hover:text-text transition-colors"
          >
            <.icon name="hero-x-mark-mini" class="size-4" /> Close
          </button>
        <% end %>
      </div>
    </section>
  <% else %>
    <!-- Hero: Latest Ping Latency -->
    <section class="pt-8 pb-6">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div>
          <p class="text-xs font-semibold tracking-[0.15em] uppercase text-text-dim mb-3">
            <%= cond do %>
              <% has_ping_data?(@latest_measurement) -> %>
                Ping Latency
              <% @latest_measurement -> %>
                Last Ping Failed
              <% true -> %>
                No Data
            <% end %>
          </p>
          <div class="flex items-baseline gap-2">
            <%= if has_ping_data?(@latest_measurement) do %>
              <span class="speed-hero">
                {Float.round(@latest_measurement.ping_latency, 1)}
                <span class="unit">ms</span>
              </span>
            <% else %>
              <span class="speed-hero text-text-ghost">
                -- <span class="unit">ms</span>
              </span>
            <% end %>
          </div>
          <div class="flex items-center gap-4 mt-3 text-sm">
            <%= if has_ping_data?(@latest_measurement) do %>
              <span class="text-text-dim">
                <span class="stat-value font-semibold text-text">
                  {Float.round(@latest_measurement.ping_jitter, 1)}
                </span>
                <span class="text-text-ghost ml-0.5">ms jitter</span>
              </span>
              <span class="text-border">|</span>
              <span class="text-text-dim">
                <span class="stat-value font-semibold text-text">
                  {Float.round(@latest_measurement.packet_loss, 1)}
                </span>
                <span class="text-text-ghost ml-0.5">% loss</span>
              </span>
              <span class="text-border">|</span>
              <span class="text-text-dim">
                <span class="stat-value font-semibold text-text">
                  {Float.round(@latest_measurement.ping_low, 1)}–{Float.round(
                    @latest_measurement.ping_high,
                    1
                  )}
                </span>
                <span class="text-text-ghost ml-0.5">ms range</span>
              </span>
              <span class="text-border">|</span>
              <span class="text-text-ghost">
                <.local_time id="latest-ping-time" at={@latest_measurement.timestamp} />
              </span>
            <% else %>
              <%= if @latest_measurement do %>
                <span class="text-text-ghost">The most recent ping produced no result</span>
              <% else %>
                <span class="text-text-ghost">Run your first ping to see latency</span>
              <% end %>
            <% end %>
          </div>
        </div>
        
<!-- Action Controls -->
        <div class="flex flex-wrap items-center gap-3 lg:pb-1">
          <div id="range-control" phx-hook="PersistRange" class="seg-control">
            <button
              phx-click="set_range"
              phx-value-range="24h"
              class={@time_range == "24h" && "active"}
            >
              24h
            </button>
            <button
              phx-click="set_range"
              phx-value-range="7d"
              class={@time_range == "7d" && "active"}
            >
              7d
            </button>
            <button
              phx-click="set_range"
              phx-value-range="30d"
              class={@time_range == "30d" && "active"}
            >
              30d
            </button>
          </div>

          <button
            id="run-ping-btn"
            phx-click="run_ping"
            class="cta-run"
            disabled={@test_running}
          >
            <.icon name="hero-signal-mini" class="size-4" /> Run Ping
          </button>
        </div>
      </div>
    </section>
  <% end %>

  <%= if @measurements == [] do %>
    <!-- Empty State -->
    <section class="border border-border rounded-xl py-20 flex flex-col items-center justify-center text-center">
      <div class="size-12 rounded-xl bg-surface-3 flex items-center justify-center mb-4">
        <.icon name="hero-signal" class="size-6 text-text-ghost" />
      </div>
      <p class="text-text-dim text-sm font-medium">No pings yet</p>
      <p class="text-text-ghost text-xs mt-1">
        Run your first ping to populate the chart
      </p>
    </section>
  <% else %>
    <!-- Ping Latency History -->
    <section class="chart-section">
      <div class="chart-section-header">
        <div class="flex items-center gap-2">
          <span class="size-2 rounded-full bg-amber"></span>
          <span class="text-xs font-semibold text-text-dim uppercase tracking-wider">
            Ping Latency
          </span>
        </div>
        <div class="flex items-center gap-4 text-xs text-text-ghost">
          <span class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-0.5 bg-amber rounded"></span> Latency
          </span>
          <span class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-0.5 bg-red rounded"></span> Jitter
          </span>
        </div>
      </div>
      <div class="chart-section-body">
        <div
          id="ping-chart"
          phx-hook="PingChart"
          phx-update="ignore"
          class="w-full"
          style="min-height: 300px;"
        >
          <canvas id="ping-chart-canvas"></canvas>
        </div>
      </div>
    </section>
  <% end %>
</Layouts.app>
