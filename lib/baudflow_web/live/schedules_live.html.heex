<Layouts.app flash={@flash} active_page={@active_page}>
  <section :if={@live_action == :index}>
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold text-text">Schedules</h1>
        <p class="text-sm text-text-dim mt-1">
          Each schedule runs on its own cron against an optional server, with its own threshold profile.
        </p>
      </div>
      <.link patch={~p"/schedules/new"} class="bf-btn-primary">
        <.icon name="hero-plus-mini" class="size-4" /> New schedule
      </.link>
    </div>

    <div :if={@schedules == []} class="glass-card">
      <div class="p-4 text-sm text-text-dim">
        No schedules yet — click <strong>New schedule</strong>.
      </div>
    </div>

    <div :if={@schedules != []} class="glass-card overflow-hidden">
      <table class="w-full text-sm" id="schedules-table">
        <thead>
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-text-ghost uppercase tracking-wider">
              Name
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-text-ghost uppercase tracking-wider">
              Cron
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-text-ghost uppercase tracking-wider">
              Server
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-text-ghost uppercase tracking-wider">
              Enabled
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-text-ghost uppercase tracking-wider">
              Next run
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-text-ghost uppercase tracking-wider">
              Streak / Level
            </th>
            <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <tr :for={schedule <- @schedules} id={"schedule-row-#{schedule.id}"}>
            <td class="px-4 py-3 font-medium text-text">{schedule.name}</td>
            <td class="px-4 py-3 font-mono text-xs text-text-dim whitespace-nowrap">
              {schedule.cron}
            </td>
            <td class="px-4 py-3 text-text-dim">{schedule.server_id || "auto"}</td>
            <td class="px-4 py-3 text-text-dim">{if schedule.enabled, do: "✓", else: "—"}</td>
            <td class="px-4 py-3 text-text-dim whitespace-nowrap">{format_next_run(schedule)}</td>
            <td class="px-4 py-3 text-text-dim">
              {schedule.breach_streak} / {schedule.escalation_level}
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <.link patch={~p"/schedules/#{schedule.id}/edit"} class="bf-btn-ghost !py-1">
                Edit
              </.link>
              <button
                type="button"
                phx-click="delete"
                phx-value-id={schedule.id}
                data-confirm="Delete this schedule? Past measurements keep their data."
                class="bf-btn-ghost !py-1 ml-2"
              >
                Delete
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section :if={@live_action in [:new, :edit]}>
    <div>
      <h1 class="text-xl font-bold text-text">
        {if @live_action == :new, do: "New schedule", else: "Edit schedule"}
      </h1>
      <p class="text-sm text-text-dim mt-1">
        Blank thresholds inherit the global Settings.
      </p>
    </div>

    <div class="glass-card">
      <.form
        :let={f}
        for={@changeset}
        id="schedule-form"
        as={:schedule}
        phx-submit="save"
        class="p-4 space-y-3"
      >
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <.input field={f[:name]} type="text" label="Name" class="bf-input" />
          <.input
            field={f[:cron]}
            type="text"
            label="Cron (5 fields)"
            class="bf-input"
            placeholder="0 * * * *"
          />
          <.input
            field={f[:server_id]}
            type="number"
            label="Server ID (blank = auto)"
            class="bf-input"
            min="0"
          />
        </div>

        <.input field={f[:enabled]} type="checkbox" label="Enabled" class="bf-checkbox" />

        <.schedule_threshold_fields form={f} policy={threshold_policy(@changeset)} />

        <div class="flex justify-between items-center pt-3 border-t border-border">
          <.link patch={~p"/schedules"} class="bf-btn-ghost">
            Cancel
          </.link>
          <button type="submit" class="bf-btn-primary">
            <.icon name="hero-check-mini" class="size-4" /> Save
          </button>
        </div>
      </.form>
    </div>
  </section>
</Layouts.app>
