<div class="glass-card">
  <div class="p-4">
    <div class="flex items-center gap-2 mb-3">
      <span class="size-2 rounded-full bg-cyan"></span>
      <span class="text-xs font-semibold text-text-dim uppercase tracking-wider">
        Baudflow · This Month
      </span>
    </div>
    <.heat_tile tile={@tile} unknown_label={@unknown_label} />
    <div class="mt-3">
      <.heat_legend unknown_label={@unknown_label} />
    </div>
  </div>
</div>
