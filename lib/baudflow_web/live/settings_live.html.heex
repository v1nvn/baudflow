<Layouts.app flash={@flash} active_page={@active_page}>
  <div>
    <h1 class="text-xl font-bold text-text">Settings</h1>
    <p class="text-sm text-text-dim mt-1">Configure scheduling, alerts, and thresholds</p>
  </div>

  <.form for={@form} id="settings-form" phx-submit="save" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Schedules -->
      <div class="glass-card">
        <div class="p-4">
          <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
            <.icon name="hero-calendar-days-mini" class="size-4" /> Schedules
          </h2>
          <p class="text-xs text-text-ghost mb-3">
            Test cadences (cron), per-schedule servers, and per-schedule thresholds
            are managed on a dedicated page.
          </p>
          <.link
            navigate={~p"/schedules"}
            id="manage-schedules-link"
            class="bf-btn-primary inline-flex items-center gap-1"
          >
            <.icon name="hero-calendar-days-mini" class="size-4" /> Manage schedules
          </.link>
        </div>
      </div>
      
<!-- Server -->
      <div class="glass-card">
        <div class="p-4">
          <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
            <.icon name="hero-globe-alt-mini" class="size-4" /> Servers
          </h2>
          <div class="space-y-3">
            <div>
              <.input
                field={@form[:preferred_servers]}
                type="text"
                id="preferred-servers-input"
                label="Preferred Servers"
                class="bf-input"
                placeholder="e.g. 12345, 67890"
              />
              <p class="text-xs text-text-ghost mt-1">
                Comma-separated server IDs. Scheduled tests pick randomly from these.
              </p>
            </div>
            <div>
              <.input
                field={@form[:blocked_servers]}
                type="text"
                id="blocked-servers-input"
                label="Blocked Servers"
                class="bf-input"
                placeholder="e.g. 54321"
              />
              <p class="text-xs text-text-ghost mt-1">
                Comma-separated server IDs to exclude from auto-selection.
              </p>
            </div>
          </div>
        </div>
      </div>
      
<!-- Data Retention -->
      <div class="glass-card">
        <div class="p-4">
          <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
            <.icon name="hero-archive-box-mini" class="size-4" /> Retention
          </h2>
          <.input
            field={@form[:retention_days]}
            type="number"
            label="Retention Days"
            class="bf-input !max-w-sm"
            min="1"
          />
          <p class="text-xs text-text-ghost mt-1">Default: 365</p>
        </div>
      </div>
      
<!-- Dashboard -->
      <div class="glass-card">
        <div class="p-4">
          <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
            <.icon name="hero-chart-bar-mini" class="size-4" /> Dashboard
          </h2>
          <.input
            field={@form[:dashboard_points]}
            type="number"
            label="Max Chart Points"
            class="bf-input !max-w-sm"
            min="1"
          />
          <p class="text-xs text-text-ghost mt-1">
            Number of data points shown (default: 500)
          </p>
        </div>
      </div>
      
<!-- Ping -->
      <div class="glass-card">
        <div class="p-4">
          <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
            <.icon name="hero-signal-mini" class="size-4" /> Ping
          </h2>
          <.input
            field={@form[:ping_target]}
            type="text"
            id="ping-target-input"
            label="Default Ping Target"
            class="bf-input !max-w-sm"
            placeholder="1.1.1.1"
          />
          <p class="text-xs text-text-ghost mt-1">
            Host a ping schedule pings when it has no target of its own.
          </p>
        </div>
      </div>
      
<!-- Promised Speeds (SLA) -->
      <div class="glass-card">
        <div class="p-4">
          <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
            <.icon name="hero-bolt-mini" class="size-4" /> Promised Speeds
          </h2>
          <p class="text-xs text-text-ghost mb-3">
            ISP-plan speeds used to compute SLA compliance on the dashboard.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <.input
              field={@form[:promised_download_mbps]}
              type="number"
              id="promised-download-input"
              label="Promised Download (Mbps)"
              class="bf-input"
              min="0"
              step="any"
              placeholder="0 = none"
            />
            <.input
              field={@form[:promised_upload_mbps]}
              type="number"
              id="promised-upload-input"
              label="Promised Upload (Mbps)"
              class="bf-input"
              min="0"
              step="any"
              placeholder="0 = none"
            />
          </div>
        </div>
      </div>
      
<!-- Thresholds -->
      <div class="glass-card">
        <div class="p-4">
          <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
            <.icon name="hero-shield-check-mini" class="size-4" /> Thresholds
          </h2>
          <div class="mb-3">
            <.input
              field={@form[:threshold_mode]}
              type="select"
              label="Health verdict mode"
              options={[
                {"Auto (relative to your baseline)", "auto"},
                {"Absolute (custom thresholds)", "absolute"},
                {"Off", "off"}
              ]}
            />
            <p class="text-xs text-text-ghost mt-1">
              <%= case @form[:threshold_mode].value do %>
                <% "auto" -> %>
                  Each test is judged against your own rolling median — flags a dip below it with no tuning.
                <% "absolute" -> %>
                  Flag each measurement against the fixed min speed / max latency below.
                <% _ -> %>
                  No health verdicts are computed.
              <% end %>
            </p>
          </div>
          <div class={[
            "grid grid-cols-1 sm:grid-cols-3 gap-3 mt-2",
            @form[:threshold_mode].value != "auto" && "opacity-40 pointer-events-none"
          ]}>
            <.input
              field={@form[:threshold_ratio]}
              type="number"
              label="Breach ratio (auto)"
              class="bf-input"
              min="0.1"
              max="0.95"
              step="0.05"
              disabled={@form[:threshold_mode].value != "auto"}
              placeholder="0.7 = flag below 70% of median"
            />
          </div>
          <div class={[
            "grid grid-cols-1 sm:grid-cols-3 gap-3 mt-2",
            @form[:threshold_mode].value != "absolute" && "opacity-40 pointer-events-none"
          ]}>
            <.input
              field={@form[:threshold_download]}
              type="number"
              label="Min Download (Mbps)"
              class="bf-input"
              min="0"
              step="any"
              disabled={@form[:threshold_mode].value != "absolute"}
              placeholder="0 = disabled"
            />
            <.input
              field={@form[:threshold_upload]}
              type="number"
              label="Min Upload (Mbps)"
              class="bf-input"
              min="0"
              step="any"
              disabled={@form[:threshold_mode].value != "absolute"}
              placeholder="0 = disabled"
            />
            <.input
              field={@form[:threshold_ping]}
              type="number"
              label="Max Ping (ms)"
              class="bf-input"
              min="0"
              step="any"
              disabled={@form[:threshold_mode].value != "absolute"}
              placeholder="0 = disabled"
            />
          </div>
        </div>
      </div>
      
<!-- Alerts -->
      <div class="glass-card">
        <div class="p-4">
          <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
            <.icon name="hero-bell-alert-mini" class="size-4" /> Alerts
          </h2>
          <p class="text-xs text-text-ghost mb-3">
            Control when a breach alert fires. Recovery and test-failure alerts are always on.
          </p>
          <.input
            field={@form[:breach_notify_streak]}
            type="number"
            id="breach-notify-streak-input"
            label="Consecutive breaches before alert"
            class="bf-input"
            min="1"
            step="1"
            placeholder="1 = first breach"
          />
        </div>
      </div>
      
<!-- Webhooks -->
      <div class="glass-card">
        <div class="p-4">
          <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
            <.icon name="hero-link-mini" class="size-4" /> Webhooks
          </h2>
          <p class="text-xs text-text-ghost mb-3">
            POST each alert as JSON to a URL (Home Assistant, Grafana, n8n). Leave the URL blank to disable.
          </p>
          <.input
            field={@form[:webhook_url]}
            type="text"
            id="webhook-url-input"
            label="Webhook URL"
            class="bf-input"
            placeholder="https://example.com/hook"
          />
          <div class="mt-3">
            <.input
              field={@form[:webhook_template]}
              type="textarea"
              id="webhook-template-input"
              label="Webhook Payload Template"
              class="bf-input font-mono text-xs"
              rows="6"
              placeholder={@webhook_template_default}
            />
            <p class="text-xs text-text-ghost mt-1">
              EEx template rendered as JSON. Variables: <code class="text-text-dim">@event</code>, <code class="text-text-dim">@measurement</code>. Blank uses the default.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex justify-end pt-4 border-t border-border">
      <button type="submit" class="bf-btn-primary">
        <.icon name="hero-check-mini" class="size-4" /> Save Settings
      </button>
    </div>
  </.form>
</Layouts.app>
