<Layouts.app flash={@flash} active_page={@active_page}>
  <!-- Health Status Bar -->
  <div class={[
    "health-bar",
    @latest_health == :healthy && "healthy",
    @latest_health == :breach && "unhealthy",
    @latest_health in [:failed, :unknown] && "unknown"
  ]}>
  </div>

  <%= if @test_running do %>
    <!-- Live Speedtest Diagnostics Panel -->
    <section class="pt-6 pb-4">
      <div
        id="speedtest-viz"
        phx-hook="SpeedtestViz"
        phx-update="ignore"
        class="crt-panel"
      >
        <!-- Phase strip -->
        <div class="crt-phase-strip">
          <span id="crt-phase-ping" class="crt-phase">PING</span>
          <span class="crt-phase-sep">───</span>
          <span id="crt-phase-download" class="crt-phase">DOWNLOAD</span>
          <span class="crt-phase-sep">───</span>
          <span id="crt-phase-upload" class="crt-phase">UPLOAD</span>
        </div>
        
<!-- Oscilloscope display -->
        <div class="crt-scope">
          <div class="crt-scanlines"></div>
          <canvas id="crt-canvas"></canvas>
          <div class="crt-readout">
            <span id="crt-speed-value" class="crt-speed-num">───</span>
            <span id="crt-speed-unit" class="crt-speed-unit-label">Mbps</span>
          </div>
        </div>
        
<!-- Live stats bar -->
        <div class="crt-stats">
          <div class="crt-stat">
            <span class="crt-stat-label">LATENCY</span>
            <span id="crt-stat-latency" class="crt-stat-value">──</span>
            <span class="crt-stat-unit">ms</span>
          </div>
          <div class="crt-stat">
            <span class="crt-stat-label">JITTER</span>
            <span id="crt-stat-jitter" class="crt-stat-value">──</span>
            <span class="crt-stat-unit">ms</span>
          </div>
          <div class="crt-stat">
            <span class="crt-stat-label">ELAPSED</span>
            <span id="crt-stat-elapsed" class="crt-stat-value">──</span>
            <span class="crt-stat-unit">s</span>
          </div>
          <div class="crt-stat">
            <span class="crt-stat-label">SERVER</span>
            <span id="crt-stat-server" class="crt-stat-value">──</span>
          </div>
        </div>
      </div>
      
<!-- Controls row during test -->
      <div class="flex items-center justify-end mt-4">
        <button
          id="run-test-btn"
          phx-click="run_test"
          class="cta-run"
          disabled={true}
        >
          <span class="inline-block size-4 border-2 border-white/30 border-t-white rounded-full animate-spin">
          </span>
          Running...
        </button>
      </div>
    </section>
  <% else %>
    <!-- Hero: Current Speed Readout -->
    <section class="pt-8 pb-6">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div>
          <p class="text-xs font-semibold tracking-[0.15em] uppercase text-text-dim mb-3">
            <%= cond do %>
              <% has_speed_data?(@latest_measurement) -> %>
                Download Speed
              <% @latest_measurement -> %>
                Last Test Failed
              <% true -> %>
                No Data
            <% end %>
          </p>
          <div class="flex items-baseline gap-2">
            <%= if has_speed_data?(@latest_measurement) do %>
              <span class="speed-hero">
                {Float.round(@latest_measurement.download_mbps, 1)}
                <span class="unit">Mbps</span>
              </span>
            <% else %>
              <span class="speed-hero text-text-ghost">
                -- <span class="unit">Mbps</span>
              </span>
            <% end %>
          </div>
          <div class="flex items-center gap-4 mt-3 text-sm">
            <%= if has_speed_data?(@latest_measurement) do %>
              <span class="text-text-dim">
                <span class="stat-value font-semibold text-text">
                  {Float.round(@latest_measurement.upload_mbps, 1)}
                </span>
                <span class="text-text-ghost ml-0.5">Mbps up</span>
              </span>
              <span class="text-border">|</span>
              <span class="text-text-dim">
                <span class="stat-value font-semibold text-text">
                  {Float.round(@latest_measurement.ping_latency, 1)}
                </span>
                <span class="text-text-ghost ml-0.5">ms</span>
              </span>
              <span class="text-border">|</span>
              <span class="text-text-dim">
                <span class="stat-value font-semibold text-text">
                  {Float.round(@latest_measurement.ping_jitter, 1)}
                </span>
                <span class="text-text-ghost ml-0.5">ms jitter</span>
              </span>
              <span class="text-border">|</span>
              <span class="text-text-ghost">
                <.local_time id="latest-time" at={@latest_measurement.timestamp} />
              </span>
            <% else %>
              <%= if @latest_measurement do %>
                <span class="text-text-ghost">The most recent test produced no result</span>
              <% else %>
                <span class="text-text-ghost">Run your first speedtest to see results</span>
              <% end %>
            <% end %>
          </div>
        </div>
        
<!-- Action Controls -->
        <div class="flex flex-wrap items-center gap-3 lg:pb-1">
          <div id="range-control" phx-hook="PersistRange" class="seg-control">
            <button
              phx-click="set_range"
              phx-value-range="24h"
              class={@time_range == "24h" && "active"}
            >
              24h
            </button>
            <button
              phx-click="set_range"
              phx-value-range="7d"
              class={@time_range == "7d" && "active"}
            >
              7d
            </button>
            <button
              phx-click="set_range"
              phx-value-range="30d"
              class={@time_range == "30d" && "active"}
            >
              30d
            </button>
          </div>

          <div class="relative">
            <select
              id="server-select"
              name="server_id"
              phx-change="select_server"
              class="bf-select max-w-[200px]"
              disabled={@test_running}
            >
              <option value="auto" selected={@selected_server_id == "auto"}>
                Auto (closest)
              </option>
              <%= for server <- @available_servers do %>
                <option
                  value={server[:id]}
                  selected={@selected_server_id == to_string(server[:id])}
                >
                  {server[:name]}{if server[:location] != "",
                    do: " - #{server[:location]}",
                    else: ""}
                </option>
              <% end %>
            </select>
            <%= if not @servers_loaded do %>
              <button
                phx-click="load_servers"
                aria-label="Load nearby servers"
                class="absolute right-7 top-1/2 -translate-y-1/2 text-text-ghost hover:text-text-dim transition-colors"
                title="Load nearby servers"
              >
                <.icon name="hero-arrow-path-mini" class="size-3.5" />
              </button>
            <% end %>
          </div>

          <div class="run-split relative inline-flex">
            <button
              id="run-test-btn"
              phx-click="run_test"
              class="cta-run cta-run-primary"
              disabled={@test_running}
            >
              <.icon name="hero-play-mini" class="size-4" /> Run Test
            </button>
            <button
              id="run-menu-toggle"
              phx-click="toggle-run-menu"
              aria-haspopup="true"
              aria-expanded={@run_menu_open}
              class="cta-run cta-run-toggle border-l border-black/20"
              disabled={@test_running}
              aria-label="More test types"
            >
              <.icon name="hero-chevron-down-mini" class="size-4" />
            </button>

            <%= if @run_menu_open do %>
              <!-- Click-away backdrop: a full-screen transparent layer behind the menu -->
              <div id="run-menu-backdrop" class="fixed inset-0 z-40" phx-click="close-run-menu">
              </div>
              <div
                class="absolute right-0 top-full mt-1 z-50 w-48 glass-card p-1 shadow-lg shadow-black/40"
                role="menu"
              >
                <.link
                  id="run-ping-item"
                  navigate={~p"/ping?run=1"}
                  class="flex items-center gap-2 px-3 py-2 text-sm rounded-md text-text hover:bg-surface-3 transition-colors"
                  role="menuitem"
                >
                  <.icon name="hero-signal-mini" class="size-4 text-amber" /> Run Ping Test
                </.link>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <%= if @measurements != [] || @compliance || @next_run do %>
    <!-- System status cluster: heatmap visualization + instrument readouts -->
    <section class="status-cluster">
      <div :if={@measurements != []} class="status-cluster-viz">
        <div class="flex items-center gap-2 mb-3">
          <span class="size-2 rounded-full bg-cyan"></span>
          <span class="text-xs font-semibold text-text-dim uppercase tracking-wider">
            Health Heatmap
          </span>
        </div>
        <.heat_tile tile={@heatmap_tile} compact unknown_label={@unknown_label} />
        <div class="mt-3">
          <.heat_legend compact unknown_label={@unknown_label} />
        </div>
      </div>

      <div :if={@next_run || @compliance} class="status-cluster-readouts">
        <div :if={@next_run} id="next-test-card" class="readout">
          <span class="readout-label">Next Scheduled Test</span>
          <div class="readout-value">
            <.local_time id="next-test-time" at={@next_run.at} />
          </div>
          <p class="readout-sub">
            {@next_run.name} schedule · {relative_to_now(@next_run.at)}
          </p>
        </div>

        <div :if={@compliance} id="compliance-card" class="readout">
          <span class="readout-label">SLA Compliance</span>
          <div class="readout-value">
            <%= if @compliance.percent do %>
              {Float.round(@compliance.percent, 1)}%
            <% else %>
              -
            <% end %>
            <span class="readout-value-note">met promised speed</span>
          </div>
          <p class="readout-sub">
            last {@time_range} · {@compliance.total} {if @compliance.total == 1,
              do: "test",
              else: "tests"}
          </p>
        </div>
      </div>
    </section>
  <% end %>

  <%= if @measurements == [] do %>
    <!-- Empty State -->
    <section class="border border-border rounded-xl py-20 flex flex-col items-center justify-center text-center">
      <div class="size-12 rounded-xl bg-surface-3 flex items-center justify-center mb-4">
        <.icon name="hero-signal" class="size-6 text-text-ghost" />
      </div>
      <p class="text-text-dim text-sm font-medium">No measurements yet</p>
      <p class="text-text-ghost text-xs mt-1">
        Run your first speedtest to populate the dashboard
      </p>
    </section>
  <% else %>
    <!-- Speed Chart - full width, the main story -->
    <section class="chart-section">
      <div class="chart-section-header">
        <div class="flex items-center gap-2">
          <span class="size-2 rounded-full bg-cyan"></span>
          <span class="text-xs font-semibold text-text-dim uppercase tracking-wider">
            Speed History
          </span>
        </div>
        <div class="flex items-center gap-4 text-xs text-text-ghost">
          <span class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-0.5 bg-cyan rounded"></span> Download
          </span>
          <span class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-0.5 bg-green rounded"></span> Upload
          </span>
        </div>
      </div>
      <div class="chart-section-body">
        <div
          id="speed-chart"
          phx-hook="SpeedChart"
          phx-update="ignore"
          class="w-full"
          style="min-height: 300px;"
        >
          <canvas id="speed-chart-canvas"></canvas>
        </div>
      </div>
    </section>
    
<!-- Network Quality Charts - 2 column -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <section class="chart-section">
        <div class="chart-section-header">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-amber"></span>
            <span class="text-xs font-semibold text-text-dim uppercase tracking-wider">Ping</span>
          </div>
        </div>
        <div class="chart-section-body">
          <div
            id="ping-chart"
            phx-hook="PingChart"
            phx-update="ignore"
            class="w-full"
            style="min-height: 220px;"
          >
            <canvas id="ping-chart-canvas"></canvas>
          </div>
        </div>
      </section>

      <section class="chart-section">
        <div class="chart-section-header">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-rose"></span>
            <span class="text-xs font-semibold text-text-dim uppercase tracking-wider">
              Jitter
            </span>
          </div>
        </div>
        <div class="chart-section-body">
          <div
            id="jitter-chart"
            phx-hook="JitterChart"
            phx-update="ignore"
            class="w-full"
            style="min-height: 220px;"
          >
            <canvas id="jitter-chart-canvas"></canvas>
          </div>
        </div>
      </section>
    </div>
    
<!-- Detail Charts - 2 column -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <section class="chart-section">
        <div class="chart-section-header">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-amber"></span>
            <span class="text-xs font-semibold text-text-dim uppercase tracking-wider">
              Ping Detail
            </span>
          </div>
        </div>
        <div class="chart-section-body">
          <div
            id="ping-detail-chart"
            phx-hook="PingDetailChart"
            phx-update="ignore"
            class="w-full"
            style="min-height: 220px;"
          >
            <canvas id="ping-detail-chart-canvas"></canvas>
          </div>
        </div>
      </section>

      <section class="chart-section">
        <div class="chart-section-header">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-cyan"></span>
            <span class="text-xs font-semibold text-text-dim uppercase tracking-wider">
              Test Duration
            </span>
          </div>
        </div>
        <div class="chart-section-body">
          <div
            id="duration-chart"
            phx-hook="DurationChart"
            phx-update="ignore"
            class="w-full"
            style="min-height: 220px;"
          >
            <canvas id="duration-chart-canvas"></canvas>
          </div>
        </div>
      </section>
    </div>
    
<!-- Reliability - full width -->
    <section class="chart-section">
      <div class="chart-section-header">
        <div class="flex items-center gap-2">
          <span class="size-2 rounded-full bg-red"></span>
          <span class="text-xs font-semibold text-text-dim uppercase tracking-wider">
            Packet Loss
          </span>
        </div>
      </div>
      <div class="chart-section-body">
        <div
          id="packet-loss-chart"
          phx-hook="PacketLossChart"
          phx-update="ignore"
          class="w-full"
          style="min-height: 160px;"
        >
          <canvas id="packet-loss-chart-canvas"></canvas>
        </div>
      </div>
    </section>
  <% end %>
</Layouts.app>
