<div>
  <h1 class="text-xl font-bold text-text">Settings</h1>
  <p class="text-sm text-text-dim mt-1">Configure scheduling, alerts, and thresholds</p>
</div>

<.form for={%{}} id="settings-form" phx-submit="save" class="space-y-4">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Schedule -->
    <div class="glass-card">
      <div class="p-4">
        <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
          <.icon name="hero-clock-mini" class="size-4" /> Schedule
        </h2>
        <div>
          <label class="block text-xs font-medium text-text-ghost mb-1.5">
            Cron Expression
          </label>
          <input
            type="text"
            name="settings[schedule_cron]"
            value={@schedule_cron}
            class="bf-input !max-w-sm"
          />
          <p class="text-xs text-text-ghost mt-1">
            Default: 0 * * * * (every hour)
          </p>
        </div>
      </div>
    </div>
    
<!-- Server -->
    <div class="glass-card">
      <div class="p-4">
        <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
          <.icon name="hero-globe-alt-mini" class="size-4" /> Servers
        </h2>
        <div class="space-y-3">
          <div>
            <label class="block text-xs font-medium text-text-ghost mb-1.5">
              Preferred Servers
            </label>
            <input
              type="text"
              id="preferred-servers-input"
              name="settings[preferred_servers]"
              value={@preferred_servers}
              class="bf-input"
              placeholder="e.g. 12345, 67890"
            />
            <p class="text-xs text-text-ghost mt-1">
              Comma-separated server IDs. Scheduled tests pick randomly from these.
            </p>
          </div>
          <div>
            <label class="block text-xs font-medium text-text-ghost mb-1.5">
              Blocked Servers
            </label>
            <input
              type="text"
              id="blocked-servers-input"
              name="settings[blocked_servers]"
              value={@blocked_servers}
              class="bf-input"
              placeholder="e.g. 54321"
            />
            <p class="text-xs text-text-ghost mt-1">
              Comma-separated server IDs to exclude from auto-selection.
            </p>
          </div>
        </div>
      </div>
    </div>
    
<!-- Data Retention -->
    <div class="glass-card">
      <div class="p-4">
        <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
          <.icon name="hero-archive-box-mini" class="size-4" /> Retention
        </h2>
        <div>
          <label class="block text-xs font-medium text-text-ghost mb-1.5">
            Retention Days
          </label>
          <input
            type="number"
            name="settings[retention_days]"
            value={@retention_days}
            class="bf-input !max-w-sm"
            min="1"
          />
          <p class="text-xs text-text-ghost mt-1">Default: 365</p>
        </div>
      </div>
    </div>
    
<!-- Alerts -->
    <div class="glass-card">
      <div class="p-4">
        <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
          <.icon name="hero-bell-alert-mini" class="size-4" /> Alerts
        </h2>
        <div>
          <label class="block text-xs font-medium text-text-ghost mb-1.5">
            Degradation Threshold
          </label>
          <input
            type="number"
            name="settings[degradation_threshold]"
            value={@degradation_threshold}
            class="bf-input !max-w-sm"
            min="0"
            step="0.1"
          />
          <p class="text-xs text-text-ghost mt-1">
            Alert below this fraction of 7-day avg (default: 0.5)
          </p>
        </div>
      </div>
    </div>
    
<!-- Dashboard -->
    <div class="glass-card">
      <div class="p-4">
        <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
          <.icon name="hero-chart-bar-mini" class="size-4" /> Dashboard
        </h2>
        <div>
          <label class="block text-xs font-medium text-text-ghost mb-1.5">
            Max Chart Points
          </label>
          <input
            type="number"
            name="settings[dashboard_points]"
            value={@dashboard_points}
            class="bf-input !max-w-sm"
            min="1"
          />
          <p class="text-xs text-text-ghost mt-1">
            Number of data points shown (default: 500)
          </p>
        </div>
      </div>
    </div>
    
<!-- Thresholds -->
    <div class="glass-card">
      <div class="p-4">
        <h2 class="text-xs font-semibold text-text-dim uppercase tracking-wider mb-3">
          <.icon name="hero-shield-check-mini" class="size-4" /> Thresholds
        </h2>
        <div class="mb-3">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="hidden" name="settings[threshold_enabled]" value="false" />
            <input
              type="checkbox"
              name="settings[threshold_enabled]"
              value="true"
              checked={@threshold_enabled == "true"}
              class="bf-checkbox"
            />
            <span class="text-xs font-medium text-text-ghost">Enable absolute thresholds</span>
          </label>
          <p class="text-xs text-text-ghost mt-1 ml-7">
            Flag each measurement as healthy/unhealthy based on min speed and max latency
          </p>
        </div>
        <div class={[
          "grid grid-cols-1 sm:grid-cols-3 gap-3 mt-2",
          @threshold_enabled != "true" && "opacity-40 pointer-events-none"
        ]}>
          <div>
            <label class="block text-xs font-medium text-text-ghost mb-1.5">
              Min Download (Mbps)
            </label>
            <input
              type="number"
              name="settings[threshold_download]"
              value={@threshold_download}
              class="bf-input"
              min="0"
              step="any"
              disabled={@threshold_enabled != "true"}
              placeholder="0 = disabled"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-text-ghost mb-1.5">
              Min Upload (Mbps)
            </label>
            <input
              type="number"
              name="settings[threshold_upload]"
              value={@threshold_upload}
              class="bf-input"
              min="0"
              step="any"
              disabled={@threshold_enabled != "true"}
              placeholder="0 = disabled"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-text-ghost mb-1.5">
              Max Ping (ms)
            </label>
            <input
              type="number"
              name="settings[threshold_ping]"
              value={@threshold_ping}
              class="bf-input"
              min="0"
              step="any"
              disabled={@threshold_enabled != "true"}
              placeholder="0 = disabled"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex justify-end pt-4 border-t border-border">
    <button type="submit" class="bf-btn-primary">
      <.icon name="hero-check-mini" class="size-4" /> Save Settings
    </button>
  </div>
</.form>
