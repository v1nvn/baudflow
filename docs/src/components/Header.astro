---
import { BASE } from '../utils';

const gh = 'https://github.com/v1nvn/baudflow';
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={BASE} aria-label="Baudflow home">
      <svg viewBox="0 0 32 32" width="22" height="22" fill="none" aria-hidden="true">
        <rect x="2" y="2" width="28" height="28" rx="8" fill="var(--surface-0)" stroke="var(--accent)" stroke-opacity="0.5" stroke-width="1.5" />
        <path d="M6 17 h4.6 l2.2 -8 l3.6 14 l2.8 -10 l2 4 h5" stroke="var(--cyan)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>baudflow</span>
    </a>
    <nav class="nav-links">
      <a href={`${BASE}features/`}>Features</a>
      <a href={`${BASE}why/`}>Why</a>
      <a href={`${BASE}docs/`}>Docs</a>
      <a href={gh} rel="noopener">GitHub ↗</a>
      <a class="btn btn-fill cta" href={`${BASE}#install`}>Get started</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: hsl(224 38% 4.5% / 0.7);
    backdrop-filter: blur(8px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 58px; }
  .brand { display: flex; align-items: center; gap: 0.5rem; font-weight: 800; letter-spacing: -0.02em; text-decoration: none; color: var(--accent); }
  .nav-links { display: flex; align-items: center; gap: 1.2rem; }
  .nav-links a { font-size: 0.88rem; font-weight: 500; color: var(--text-dim); text-decoration: none; }
  .nav-links a:hover { color: var(--text); }
  .nav-links .cta { color: #000; }
  @media (max-width: 720px) {
    .nav-links { gap: 0.6rem; }
    .nav-links a:not(.cta) { display: none; }
  }
</style>
