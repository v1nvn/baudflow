---
// Framed browser-chrome window showing the dashboard.
// To use a real screenshot instead: drop dashboard.png into site/public/screenshots/
// and replace the <WindowMock /> block with:
//   <img src={asset('screenshots/dashboard.png')} alt="Baudflow dashboard" />
---

<div class="win">
  <div class="win-bar">
    <span class="dot" style="background:var(--red)"></span>
    <span class="dot" style="background:var(--amber)"></span>
    <span class="dot" style="background:var(--green)"></span>
    <span class="win-url">localhost:4000 · baudflow dashboard</span>
  </div>
  <div class="win-body">
    <div class="tiles">
      <div class="tile"><div class="tl">DOWNLOAD</div><div class="tv down">247.3</div></div>
      <div class="tile"><div class="tl">UPLOAD</div><div class="tv up">42.1</div></div>
      <div class="tile"><div class="tl">PING</div><div class="tv ping">14.2</div></div>
    </div>
    <div class="chart">
      <svg viewBox="0 0 600 110" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,90 L0,70 L50,66 L100,50 L150,58 L200,40 L250,46 L300,28 L350,36 L400,22 L450,30 L500,18 L550,24 L600,14 L600,110 L0,110 Z" fill="hsl(198 95% 52% / 0.12)" />
        <polyline points="0,70 50,66 100,50 150,58 200,40 250,46 300,28 350,36 400,22 450,30 500,18 550,24 600,14" fill="none" stroke="var(--accent)" stroke-width="1.6" />
        <polyline points="0,98 50,96 100,94 150,92 200,90 250,88 300,86 350,84 400,82 450,80 500,78 550,76 600,74" fill="none" stroke="var(--green)" stroke-width="1.6" opacity="0.65" />
      </svg>
    </div>
    <div class="chip-row">
      <span class="chip"><span class="led"></span>HEALTHY · within thresholds</span>
    </div>
  </div>
</div>

<style>
  .win {
    max-width: 48rem;
    margin: 0 auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-1);
    overflow: hidden;
    box-shadow: 0 14px 50px rgba(0, 0, 0, 0.45);
  }
  .win-bar { display: flex; align-items: center; gap: 0.35rem; padding: 0.6rem 0.85rem; background: var(--surface-2); border-bottom: 1px solid var(--border); }
  .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; }
  .win-url { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-ghost); margin-left: 0.6rem; }
  .win-body { padding: 1rem; }

  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; margin-bottom: 0.85rem; }
  .tile { border: 1px solid var(--border); border-radius: 0.5rem; background: var(--surface-2); padding: 0.65rem 0.8rem; }
  .tl { font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em; color: var(--text-ghost); }
  .tv { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-weight: 700; font-size: 1.2rem; margin-top: 0.2rem; }
  .down { color: var(--accent); }
  .up { color: var(--green); }
  .ping { color: var(--amber); }

  .chart { border: 1px solid var(--border); border-radius: 0.5rem; background: var(--surface-0); padding: 0.6rem; }
  .chart svg { width: 100%; height: 110px; display: block; }

  .chip-row { margin-top: 0.75rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.18rem 0.6rem; border-radius: 999px; font-family: var(--font-mono); font-size: 0.62rem; font-weight: 600; color: var(--green); background: hsl(153 88% 52% / 0.1); border: 1px solid hsl(153 88% 52% / 0.2); }
  .led { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--green); box-shadow: 0 0 6px var(--green); }

  @media (max-width: 560px) { .tiles { grid-template-columns: 1fr; } }
</style>
