---
// Reusable framed screenshot — a clean frame around an optimized <Image/>.
// Used across the landing, /features, /why, and doc pages so captures share one consistent frame.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** An imported src/ asset (ImageMetadata), so Astro optimizes it to WebP. */
  src: ImageMetadata;
  alt: string;
  /** Caption shown under the image (optional). */
  caption?: string;
  /** Render at the full content width instead of the narrower card width. */
  wide?: boolean;
}
const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={['shot', { wide }]}>
  <Image src={src} alt={alt} layout="constrained" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-1);
    overflow: hidden;
    box-shadow: 0 14px 50px rgba(0, 0, 0, 0.45);
  }
  .shot.wide { max-width: none; }
  .shot img { display: block; width: 100%; height: auto; }
  figcaption {
    padding: 0.6rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    border-top: 1px solid var(--border-subtle);
  }
</style>
