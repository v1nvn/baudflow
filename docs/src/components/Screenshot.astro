---
// Reusable framed screenshot — a browser-chrome window (traffic-light dots +
// location bar) wrapped around an optimized <Image/>. Used across the landing,
// /features, /why, and doc pages so captures share one consistent frame.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** An imported src/ asset (ImageMetadata), so Astro optimizes it to WebP. */
  src: ImageMetadata;
  alt: string;
  /** Caption shown under the image (optional). */
  caption?: string;
  /** Fake location-bar label (defaults to the live host). */
  url?: string;
  /** Render at the full content width instead of the narrower card width. */
  wide?: boolean;
}
const { src, alt, caption, url = 'baudflow.v1n.space', wide = false } = Astro.props;
---

<figure class:list={['shot', { wide }]}>
  <div class="shot-bar">
    <span class="dot" style="background:var(--red)"></span>
    <span class="dot" style="background:var(--amber)"></span>
    <span class="dot" style="background:var(--green)"></span>
    <span class="shot-url">{url}</span>
  </div>
  <Image src={src} alt={alt} layout="constrained" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-1);
    overflow: hidden;
    box-shadow: 0 14px 50px rgba(0, 0, 0, 0.45);
  }
  .shot.wide { max-width: none; }
  .shot-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.85rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; }
  .shot-url { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-ghost); margin-left: 0.6rem; }
  .shot img { display: block; width: 100%; height: auto; }
  figcaption {
    padding: 0.6rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    border-top: 1px solid var(--border-subtle);
  }
</style>
