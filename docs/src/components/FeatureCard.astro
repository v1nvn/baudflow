---
import Icon from './Icon.astro';
interface Props {
  name: import('./Icon.astro').Props['name'];
  title: string;
}
const { name, title } = Astro.props;
---

<article class="fcard">
  <span class="ficon"><Icon name={name} /></span>
  <h3>{title}</h3>
  <p><slot /></p>
</article>

<style>
  .fcard {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    padding: 1.1rem 1.2rem;
    height: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .fcard:hover {
    border-color: var(--accent);
    box-shadow: 0 0 18px hsl(198 95% 52% / 0.08);
  }
  .ficon { color: var(--accent); font-size: 1.3rem; display: inline-flex; }
  .fcard h3 { margin: 0.7rem 0 0.35rem; font-size: 0.98rem; }
  .fcard p { margin: 0; color: var(--text-dim); font-size: 0.86rem; line-height: 1.5; }
</style>
