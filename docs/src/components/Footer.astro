---
import { BASE } from '../utils';
import { version } from '../version';

const year = new Date().getFullYear();
const gh = 'https://github.com/v1nvn/baudflow';
const versionTag = version ? ` · v${version}` : '';
---

<footer class="site-footer">
  <div class="container row">
    <div class="brand-col">
      <a class="brand" href={BASE}>
        <img src={`${BASE}logo.svg`} width="18" height="18" alt="" />
        <span>baudflow</span>
      </a>
      <p class="meta">Self-hosted network monitoring{versionTag} · AGPL-3.0</p>
    </div>
    <nav class="foot-links">
      <a href={`${BASE}docs/`}>Docs</a>
      <a href={`${BASE}articles/`}>Articles</a>
      <a href={gh} rel="noopener">GitHub ↗</a>
      <a href={`${gh}/blob/main/CHANGELOG.md`} rel="noopener">Changelog</a>
    </nav>
    <p class="copy">© {year} Baudflow</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); padding: 2rem 0 2.5rem; margin-top: 2rem; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 0.45rem; font-weight: 800; color: var(--accent); text-decoration: none; }
  .meta { margin: 0.3rem 0 0; font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-ghost); }
  .foot-links { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .foot-links a { font-size: 0.82rem; color: var(--text-dim); text-decoration: none; }
  .foot-links a:hover { color: var(--accent); }
  .copy { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-ghost); margin: 0; }
</style>
