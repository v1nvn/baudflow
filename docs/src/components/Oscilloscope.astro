---
// Static CRT oscilloscope hero. Crisp and dependency-free (no screenshot).
// Motion could be added later behind prefers-reduced-motion.
---

<div class="scope-wrap">
  <div class="phase">
    <span class="pill done">PING ✓</span>
    <span class="pill active">DOWNLOAD ◉</span>
    <span class="pill todo">UPLOAD</span>
  </div>

  <div class="scope">
    <svg viewBox="0 0 600 220" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="oscFade" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="hsl(186,92%,52%)" stop-opacity="0.25" />
          <stop offset="1" stop-color="hsl(186,92%,52%)" stop-opacity="0" />
        </linearGradient>
        <filter id="oscGlow"><feGaussianBlur stdDeviation="2.4" /></filter>
      </defs>
      <path d="M0,150 C60,150 80,40 140,40 C200,40 220,150 300,150 C380,150 400,60 460,60 C520,60 540,140 600,140 L600,220 L0,220 Z" fill="url(#oscFade)" />
      <path d="M0,150 C60,150 80,40 140,40 C200,40 220,150 300,150 C380,150 400,60 460,60 C520,60 540,140 600,140" fill="none" stroke="hsl(186,92%,52%)" stroke-width="2" filter="url(#oscGlow)" opacity="0.7" />
      <path d="M0,150 C60,150 80,40 140,40 C200,40 220,150 300,150 C380,150 400,60 460,60 C520,60 540,140 600,140" fill="none" stroke="hsl(186,92%,52%)" stroke-width="1.4" />
    </svg>
    <div class="readout">
      <div class="num">247.3</div>
      <div class="num-lbl">Mbps · DOWNLOAD</div>
    </div>
    <div class="scan"></div>
  </div>

  <div class="stats">
    <span>PING <b>14.2 ms</b></span>
    <span>JITTER <b>1.8 ms</b></span>
    <span>LOSS <b>0.0%</b></span>
    <span>SERVER <b>Ookla · Stockholm</b></span>
  </div>
</div>

<style>
  .scope-wrap { width: 100%; }
  .phase { display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 0.8rem; font-family: var(--font-mono); font-size: 0.66rem; font-weight: 600; letter-spacing: 0.1em; }
  .pill { padding: 0.22rem 0.6rem; border-radius: 0.28rem; border: 1px solid transparent; }
  .pill.done { color: var(--green); border-color: hsl(153 88% 52% / 0.25); background: hsl(153 88% 52% / 0.06); }
  .pill.active { color: var(--cyan); border-color: hsl(186 92% 52% / 0.3); background: hsl(186 92% 52% / 0.08); text-shadow: 0 0 8px hsl(186 92% 52% / 0.6); }
  .pill.todo { color: rgba(255, 255, 255, 0.15); }

  .scope {
    position: relative;
    height: clamp(200px, 30vw, 260px);
    border: 1px solid hsl(186 92% 52% / 0.12);
    border-radius: var(--radius);
    background: var(--surface-0);
    overflow: hidden;
    box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.5), 0 0 30px hsl(186 92% 52% / 0.05);
  }
  .scope svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .readout { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; }
  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    color: var(--cyan);
    letter-spacing: -0.02em;
    text-shadow: 0 0 10px hsl(186 92% 52% / 0.8), 0 0 30px hsl(186 92% 52% / 0.4), 0 0 60px hsl(186 92% 52% / 0.15);
  }
  .num-lbl { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.18em; color: rgba(255, 255, 255, 0.4); margin-top: 0.25rem; }
  .scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(to bottom, transparent 0 3px, rgba(0, 0, 0, 0.16) 3px 4px); mix-blend-mode: multiply; }

  .stats { display: flex; justify-content: center; flex-wrap: wrap; gap: 1.4rem; margin-top: 0.9rem; font-family: var(--font-mono); font-size: 0.68rem; color: rgba(255, 255, 255, 0.3); }
  .stats b { color: rgba(255, 255, 255, 0.72); font-weight: 600; }
</style>
