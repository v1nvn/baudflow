---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BASE } from '../utils';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Baudflow — a self-hosted network monitoring platform. Automated Ookla speed tests, live ping diagnostics, adaptive schedules, and health tracking.',
} = Astro.props;
const fullTitle = title.includes('Baudflow') ? title : `${title} · Baudflow`;
const ogImage = `${BASE}og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="hsl(224, 38%, 4.5%)" />
    <link rel="icon" href={`${BASE}favicon.ico`} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
