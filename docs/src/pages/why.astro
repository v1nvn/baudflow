---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screenshot from '../components/Screenshot.astro';
import { BASE, asset } from '../utils';

const problems = [
  {
    kicker: 'The evidence gap',
    title: 'A flaky connection with nothing to show for it',
    body: 'You know your internet drops at 8pm every night — but "it feels slow" is not a support ticket. Baudflow stores every result in full and rolls it into SLA percentages, breach timelines, and heatmaps: the kind of record an ISP actually has to answer for.',
  },
  {
    kicker: 'The blind spot',
    title: 'Most outages are not about throughput',
    body: 'Latency spikes, jitter, and packet loss hit long before bandwidth drops. A speed test every hour will happily report full speed while your video calls are falling apart. A first-class ping runner — sampling continuously, with its own live console — catches what throughput misses.',
  },
  {
    kicker: 'The ceiling',
    title: 'One cron is a tracker, not a platform',
    body: 'Running a speed test on a schedule and plotting the result is a Saturday-afternoon project. Multiple schedules, adaptive cadence, health evaluation, and a four-layer alert pipeline are what turn that into something you trust to watch your network for you.',
  },
];

const differentiators = [
  { icon: '↯', title: 'Adaptive cadence', body: 'When a schedule breaches, it runs faster — on its own — until it recovers, then slows back down. A detailed outage timeline without paying for it in bandwidth.' },
  { icon: '∿', title: 'Real-time, not refresh', body: 'LiveView streams each phase and each ping sample over PubSub. You watch the test happen, you do not wait on a spinner.' },
  { icon: '◌', title: 'Ping as a peer', body: 'Ping is not a side feature — it has its own page, its own live diagnostics panel, and its own health evaluation. Most outages are its domain.' },
  { icon: '☰', title: 'Schedules are data', body: 'Run hourly against your ISP, every 15 minutes against Cloudflare, a ping every minute. The scheduler is a thin dispatcher over a table, not a config file.' },
  { icon: '∑', title: 'Built for ISP accountability', body: 'SLA compliance, breach evidence, and an export-friendly record of raw measurements — the deliverables for a refund or a fault report.' },
  { icon: '◔', title: 'Plays with your stack', body: 'Prometheus /metrics, webhooks, an embeddable heatmap, and a /health endpoint. It slots into Grafana, Home Assistant, and Uptime Kuma without ceremony.' },
];
---

<BaseLayout title="Why baudflow — Baudflow" description="Baudflow is a monitoring platform, not a cron job with a web UI — built for homelabbers who want proof, patterns, and alerts, not just a number.">
  <section class="hero">
    <div class="container">
      <span class="kicker">Why baudflow</span>
      <h1>A monitoring platform,<br /><em>not a cron job</em> with a web UI.</h1>
      <p class="lede">
        A speed test on a schedule tells you a number. baudflow tells you whether
        your connection is healthy, when it broke, how badly, and whether your ISP
        is delivering what you pay for.
      </p>
      <div class="ctas">
        <a class="btn btn-fill" href={`${BASE}#install`}>▶ Get started</a>
        <a class="btn btn-ghost" href={`${BASE}features/`}>See the features</a>
      </div>
    </div>
  </section>

  <section class="section shot-band">
    <div class="container">
      <Screenshot
        src={asset('screenshots/dashboard.png')}
        alt="The baudflow dashboard — hero readout, health heatmap, SLA compliance, and speed history on one screen."
        url="baudflow.v1n.space"
      />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head">
        <span class="kicker">The problem</span>
        <h2>Three gaps a speed test leaves open</h2>
      </div>
      <div class="stack">
        {problems.map((p) => (
          <article class="problem">
            <span class="pkicker">{p.kicker}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section diff">
    <div class="container">
      <div class="section-head">
        <span class="kicker">What makes it different</span>
        <h2>Designed for people who actually look at the data</h2>
        <p>The features that move baudflow from "speed test logger" to "the thing that watches your network".</p>
      </div>
      <div class="diff-grid">
        {differentiators.map((d) => (
          <article class="dcard">
            <span class="dicon" aria-hidden="true">{d.icon}</span>
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section thesis">
    <div class="container narrow">
      <div class="section-head">
        <span class="kicker">The thesis</span>
        <h2>Raw data is sacred. Derived views are cheap.</h2>
      </div>
      <div class="prose">
        <p>
          baudflow stores the complete raw result of every test and derives
          everything else — health verdicts, SLA percentages, heatmaps, chart
          annotations — on the fly. Change your thresholds and every view
          re-derives instantly; nothing is backfilled, nothing is lost.
        </p>
        <p>
          The architecture is built to stay that way. Test backends and
          notification channels are behaviour implementations, not branches in a
          worker. Schedules, escalation, and health are each owned by exactly one
          module. Features are additive — a new row, a new function, a new module —
          which is how a small project stays clean as it grows into a platform.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 4rem 0 2rem; text-align: center; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; max-width: 20ch; margin: 0.7rem auto 0.9rem; }
  .hero h1 em { font-style: normal; color: var(--cyan); text-shadow: 0 0 16px hsl(186 92% 52% / 0.45); }
  .lede { color: var(--text-dim); max-width: 58ch; margin: 0 auto 1.7rem; }
  .ctas { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; }

  .narrow { max-width: 52rem; }
  .shot-band { padding-top: 0.5rem; padding-bottom: 1rem; }
  .stack { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1rem; }
  .problem { border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: var(--radius); background: var(--surface-2); padding: 1.4rem 1.6rem; }
  .pkicker { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
  .problem h3 { font-size: 1.15rem; margin: 0.4rem 0 0.6rem; }
  .problem p { margin: 0; color: var(--text-dim); line-height: 1.6; }

  .diff { border-top: 1px solid var(--border); }
  .diff-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .dcard { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); padding: 1.2rem 1.3rem; }
  .dicon { font-family: var(--font-mono); color: var(--accent); font-size: 1.2rem; }
  .dcard h3 { margin: 0.55rem 0 0.4rem; font-size: 1rem; }
  .dcard p { margin: 0; color: var(--text-dim); font-size: 0.88rem; line-height: 1.55; }
  @media (max-width: 820px) { .diff-grid { grid-template-columns: 1fr; } }

  .thesis { border-top: 1px solid var(--border); }
  .thesis .prose { margin: 0 auto; }
  .thesis .prose p { color: var(--text-dim); line-height: 1.7; margin: 0 0 1.1rem; }
  .thesis .prose p:last-child { margin-bottom: 0; }
</style>
