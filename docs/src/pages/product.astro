---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screenshot from '../components/Screenshot.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Terminal from '../components/Terminal.astro';
import Icon from '../components/Icon.astro';
import { BASE } from '../utils';
import { comparisonRows, cellMark, stRepo } from '../data/comparison';
import { productFaqs } from '../data/faq';
import dashboard from '../assets/screenshots/dashboard.png';
import oscilloscope from '../assets/screenshots/oscilloscope.jpg';
import ping from '../assets/screenshots/ping.png';
import heatmap from '../assets/screenshots/heatmap.png';
import schedules from '../assets/screenshots/schedules.png';

const gh = 'https://github.com/v1nvn/baudflow';

// The worldview as arguments: each gap a single cron leaves open, paired with
// the named feature that closes it as the payoff.
const points = [
  {
    icon: 'cadence',
    point: 'One fixed cadence is wasteful',
    payoff: 'Adaptive cadence',
    body: 'An hourly test gives you a single point per hour — during an outage that is a blur, and the rest of the time you are burning bandwidth for nothing. A breached schedule runs faster on its own until it recovers, then slows back down: a detailed outage timeline without paying for it in bandwidth.',
  },
  {
    icon: 'ping',
    point: 'Latency, jitter, and loss degrade before throughput',
    payoff: 'First-class ping',
    body: 'A speed test every hour will happily report full speed while your video calls fall apart. A continuous TCP-connect ping runner with its own live console catches what throughput misses — most outages are its domain.',
  },
  {
    icon: 'sla',
    point: 'A bare Mbps number is not evidence',
    payoff: 'SLA + raw retention',
    body: '"It feels slow" is not a support ticket. baudflow stores every result in full and rolls it into SLA percentages, breach timelines, and heatmaps: the kind of record an ISP actually has to answer for.',
  },
  {
    icon: 'pipeline',
    point: 'A pile of if-statements cries wolf',
    payoff: 'Four-layer alert pipeline',
    body: 'Threshold checks bolted onto a cron fire on every re-check. baudflow\'s event → policy → template → channel pipeline gates a breach to fire exactly once — and notifies on recovery and on outright failure — so an alert means something.',
  },
];

// The canonical feature catalog, in four groups. The full item set is kept;
// group `lead` lines stay one-line orienters, not re-pitches.
const groups = [
  {
    kicker: 'Real-time visibility',
    title: 'Watch every test happen',
    lead: 'Baudflow streams progress over PubSub as it runs, with no spinner, polling, or waiting for a result to land.',
    items: [
      { name: 'oscilloscope', title: 'Live CRT oscilloscope', body: 'Ookla NDJSON streamed line-by-line over Erlang ports, with phase tracking and phosphor afterglow as the waveform builds.' },
      { name: 'ping', title: 'Live ping diagnostics', body: 'A dedicated /ping page streams each TCP-connect sample: cumulative avg, jitter, low/high, and loss, updating live.' },
      { name: 'manual', title: 'Manual runs + history', body: 'Trigger a test instantly, or let the scheduler run. Every run is logged with success, failure, or timeout status.' },
      { name: 'drill', title: 'Per-result drill-down', body: 'Ping, jitter, packet loss, server, ISP. Every measurement is fully inspectable, with the raw JSON preserved.' },
    ],
  },
  {
    kicker: 'Health intelligence',
    title: 'From numbers to a verdict',
    lead: 'Health is derived just-in-time from thresholds, never stored, so changing your mode re-derives every view instantly.',
    items: [
      { name: 'cadence', title: 'Adaptive cadence', body: 'A breached schedule switches to a faster escalated cron until it recovers, capturing outage detail without wasted bandwidth.' },
      { name: 'thresholds', title: 'Auto / absolute / off', body: 'Auto judges against your own rolling baseline (zero-config); absolute uses fixed Mbps/ms; off disables verdicts.' },
      { name: 'streaks', title: 'Breach streaks & transitions', body: 'Healthy → breach → recovered transitions, tracked atomically per schedule and surfaced to alerts and escalation.' },
      { name: 'sla', title: 'SLA compliance', body: 'The percentage of tests that met your promised speeds: "delivered 91.3% of the month" instead of a bare Mbps number.' },
      { name: 'heatmap', title: 'Health heatmap', body: 'A GitHub-style calendar wall revealing evening congestion, weekend slowdowns, and recurring outages at a glance.' },
    ],
  },
  {
    kicker: 'Alerts that don\'t cry wolf',
    title: 'A pipeline, not a pile of if-statements',
    lead: 'Event → policy → template → channel. Each layer is one concern; the policy decides whether to notify before any work is done.',
    items: [
      { name: 'pipeline', title: 'Four-layer pipeline', body: 'A pure policy module, a per-channel template renderer, and a channel behaviour. Adding a channel is one module.' },
      { name: 'gate', title: 'Breach-streak gating', body: 'A breach fires exactly once, when the streak first reaches your threshold, not on every re-check. Less noise.' },
      { name: 'recovery', title: 'Recovery & failure alerts', body: 'Get notified when service recovers, and when a run outright fails, not only on degradation.' },
      { name: 'ntfy', title: 'ntfy', body: 'Push to a self-hosted or hosted ntfy.sh topic, wired through application env.' },
      { name: 'webhook', title: 'Webhooks + templates', body: 'POST JSON to Home Assistant, Grafana, n8n, or a custom endpoint, with an editable EEx body. Blank URL disables it.' },
    ],
  },
  {
    kicker: 'Fits your stack',
    title: 'Born for the homelab',
    lead: 'Standard interfaces, plain text, no lock-in. Baudflow slots into the observability setup you already run.',
    items: [
      { name: 'metrics', title: 'Prometheus /metrics', body: 'Eight baudflow_* gauges in hand-rolled text format, NaN for stale values. Scrape it like any exporter.' },
      { name: 'health', title: '/health endpoint', body: 'A lightweight liveness check for Uptime Kuma or a Kubernetes probe.' },
      { name: 'embed', title: 'Embeddable heatmap', body: 'A chrome-less /heatmap/embed for iframing into Home Assistant or Grafana dashboards.' },
      { name: 'rawjson', title: 'Raw JSON retention', body: 'The full result is stored on every measurement; derived views are cheap, raw data is sacred. Pruned by retention.' },
      { name: 'docker', title: 'Multi-arch Docker', body: 'A non-root, Ookla-bundled image for amd64 and arm64. One container, one Postgres.' },
    ],
  },
];

const site = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('og.png', site).href;
const updated = '2026-06-30';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Baudflow: a self-hosted network monitoring platform',
  description:
    'Why baudflow exists, the gaps a single cron leaves open, the full feature walkthrough, how it compares to speedtest-tracker, and answers to the common objections.',
  datePublished: updated,
  dateModified: updated,
  author: { '@type': 'Person', name: 'v1nvn', url: 'https://github.com/v1nvn' },
  publisher: { '@type': 'Organization', name: 'Baudflow', url: site.href },
  mainEntityOfPage: pageUrl,
  image: ogImage,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
    { '@type': 'ListItem', position: 2, name: 'Product', item: pageUrl },
  ],
};
---

<BaseLayout
  title="Baudflow: a self-hosted network monitoring platform"
  description="Why baudflow exists: a monitoring platform, not a cron job. Live real-time tests, a first-class ping runner, adaptive schedules, SLA tracking, health heatmaps, and a four-layer alert pipeline."
  ogType="article"
  schema={[articleSchema, breadcrumbSchema]}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <span class="kicker">Self-hosted network monitoring</span>
      <h1>A monitoring platform,<br /><em>not a cron job</em> with a web UI.</h1>
      <p class="lede">
        A speed test on a schedule tells you a number. baudflow tells you whether
        your connection is healthy, when it broke, how badly, and whether your ISP
        is delivering what you pay for.
      </p>
      <div class="ctas">
        <a class="btn btn-fill" href="#install">Get started</a>
        <a class="btn btn-ghost" href="#features">See the features</a>
        <a class="btn btn-ghost" href={gh} rel="noopener">Star on GitHub</a>
      </div>
    </div>
  </section>

  <!-- WHY IT EXISTS -->
  <section id="philosophy" class="section thesis">
    <div class="container narrow">
      <div class="section-head">
        <span class="kicker">Why baudflow exists</span>
        <h2>Raw data is sacred. Derived views are cheap.</h2>
      </div>
      <div class="prose">
        <p>
          baudflow is a monitoring platform, not a cron job with a web UI — built
          for homelabbers who want proof, patterns, and alerts, not just a number.
        </p>
        <p>
          baudflow stores the complete raw result of every test and derives
          everything else (health verdicts, SLA percentages, heatmaps, chart
          annotations) on the fly. Change your thresholds and every view
          re-derives instantly; nothing is backfilled, nothing is lost.
        </p>
        <p>
          The architecture is built to stay that way. Test backends and
          notification channels are behaviour implementations, not branches in a
          worker. Schedules, escalation, and health are each owned by exactly one
          module. Features are additive (a new row, a new function, a new module),
          which is how a small project stays clean as it grows into a platform.
        </p>
      </div>
    </div>
  </section>

  <!-- THE CASE -->
  <section id="arguments" class="section case">
    <div class="container">
      <div class="section-head">
        <span class="kicker">The case for baudflow</span>
        <h2>The gaps a single cron leaves open</h2>
        <p>Each argument lands on a feature, by name, as the payoff.</p>
      </div>
      <div class="arg-grid">
        {points.map((p) => (
          <article class="arg">
            <span class="aicon"><Icon name={p.icon} /></span>
            <h3>{p.point}</h3>
            <p>{p.body}</p>
            <span class="payoff">→ {p.payoff}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURE WALKTHROUGH -->
  <section id="features" class="section showcase">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Feature walkthrough</span>
        <h2>Everything a flaky connection can throw at you</h2>
        <p>Live visualization, adaptive schedules, health intelligence, and a real alert pipeline, all self-hosted, all in one Phoenix LiveView app.</p>
      </div>
      <Screenshot
        src={dashboard}
        alt="The baudflow dashboard, live readout, health heatmap, SLA compliance, and speed history."
        wide
      />
      <div class="shot-duo">
        <Screenshot
          src={oscilloscope}
          alt="A live Ookla speed test streaming into the CRT oscilloscope, download phase, 516 Mbps and climbing."
        />
        <Screenshot
          src={ping}
          alt="The /ping page with a live per-sample diagnostics panel, average latency, jitter, loss, and a bar for each sample."
        />
      </div>
      <div class="shot-duo">
        <Screenshot
          src={heatmap}
          alt="The health heatmap, a calendar wall of daily speed-test health."
        />
        <Screenshot
          src={schedules}
          alt="The schedules table, multiple cron schedules, each with its own test type and escalation state."
        />
      </div>
    </div>
  </section>

  {groups.map((g) => (
    <section class="section group">
      <div class="container">
        <div class="group-head">
          <span class="kicker">{g.kicker}</span>
          <h2>{g.title}</h2>
          <p>{g.lead}</p>
        </div>
        <div class="card-grid">
          {g.items.map((f) => (
            <FeatureCard name={f.name} title={f.title}>{f.body}</FeatureCard>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- GUIDES (cluster hub → spokes) -->
  <section class="section pguides">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Go deeper</span>
        <h2>Guides</h2>
        <p>Problem-first walkthroughs for the questions that bring people here, each pointing back to this catalog.</p>
      </div>
      <div class="pguide-grid">
        <a class="pguide" href={`${BASE}docs/self-host/`}>
          <h3>Self host</h3>
          <p>Run the Ookla CLI from your own network and own every result.</p>
        </a>
        <a class="pguide" href={`${BASE}docs/monitor-isp-speed/`}>
          <h3>Monitor ISP speed</h3>
          <p>Build the record that holds your provider to what you pay for.</p>
        </a>
        <a class="pguide" href={`${BASE}docs/internet-speed-sla/`}>
          <h3>Internet speed SLA</h3>
          <p>The share of tests that hit your promised speed, tracked over time.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- HOW IT COMPARES -->
  <section id="compare" class="section compare">
    <div class="container">
      <div class="section-head">
        <span class="kicker">How it compares</span>
        <h2>baudflow vs speedtest-tracker</h2>
        <p>Green = yes · Amber = partial / planned · - = not available. The full, source-cited breakdown lives on the compare page.</p>
      </div>
      <div class="table-scroll">
        <table class="matrix">
          <thead>
            <tr>
              <th class="col-feature">Capability</th>
              <th>Baudflow</th>
              <th>speedtest-tracker</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((r) => (
              <tr>
                <td class="col-feature">
                  {r.f}
                  {r.note && <span class="note" set:html={r.note} />}
                </td>
                <td class="cell" set:html={cellMark(r.b)}></td>
                <td class="cell" set:html={cellMark(r.s)}></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="more">
        <a href={`${BASE}compare/speedtest-tracker/`}>Read the full comparison →</a>
        &nbsp;·&nbsp;
        <a href={stRepo} rel="noopener">speedtest-tracker ↗</a>
      </p>
    </div>
  </section>

  <!-- OBJECTION FAQ -->
  <section id="faq" class="section faqsec">
    <div class="container narrow">
      <div class="section-head">
        <span class="kicker">Objections</span>
        <h2>Common questions before you run it</h2>
      </div>
      <dl class="faq">
        {productFaqs.map((f) => (
          <div class="qa">
            <dt>{f.q}</dt>
            <dd><p>{f.a}</p></dd>
          </div>
        ))}
      </dl>
      <p class="more"><a href={`${BASE}faq/`}>See the full FAQ →</a></p>
    </div>
  </section>

  <!-- INSTALL -->
  <section id="install" class="section install">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Up in under a minute</span>
        <h2>Quick start</h2>
        <p>The Ookla CLI is bundled in the image. Bring Postgres and just run the container.</p>
      </div>
      <Terminal />
      <p class="post-install">
        Need more detail? Read the <a href={`${BASE}docs/getting-started/`}>getting started guide</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 3.5rem 0 1rem; text-align: center; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; max-width: 20ch; margin: 0.7rem auto 0.9rem; }
  .hero h1 em { font-style: normal; color: var(--cyan); }
  .lede { color: var(--text-dim); max-width: 58ch; margin: 0 auto 1.7rem; }
  .ctas { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; }

  .narrow { max-width: 52rem; }
  .thesis { border-top: 1px solid var(--border); }
  .thesis .section-head { margin-bottom: 1.5rem; }
  .thesis .prose { margin: 0 auto; }
  .thesis .prose p { color: var(--text-dim); line-height: 1.7; margin: 0 0 1.1rem; }
  .thesis .prose p:last-child { margin-bottom: 0; }

  .case { border-top: 1px solid var(--border); }
  .arg-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .arg { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); padding: 1.4rem 1.6rem; }
  .aicon { color: var(--accent); font-size: 1.3rem; display: inline-flex; }
  .arg h3 { margin: 0.6rem 0 0.5rem; font-size: 1.1rem; }
  .arg p { margin: 0 0 0.9rem; color: var(--text-dim); line-height: 1.6; }
  .payoff { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.06em; color: var(--accent); }
  @media (max-width: 760px) { .arg-grid { grid-template-columns: 1fr; } }

  .showcase { border-top: 1px solid var(--border); padding-top: 2rem; }
  .shot-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  @media (max-width: 760px) { .shot-duo { grid-template-columns: 1fr; } }

  .group { border-top: 1px solid var(--border); }
  .group-head { max-width: 44rem; margin: 0 auto 2rem; text-align: center; }
  .group-head h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 800; margin: 0.4rem 0 0.6rem; }
  .group-head p { color: var(--text-dim); margin: 0; }
  .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  @media (max-width: 820px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .card-grid { grid-template-columns: 1fr; } }

  .compare { border-top: 1px solid var(--border); }
  .table-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
  .matrix { width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 540px; }
  .matrix th, .matrix td { padding: 0.7rem 1rem; text-align: left; border-bottom: 1px solid var(--border-subtle); vertical-align: top; }
  .matrix thead th { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-ghost); background: var(--surface-2); }
  .matrix th:nth-child(2), .matrix th:nth-child(3) { text-align: center; }
  .matrix .col-feature { font-weight: 600; color: var(--text); max-width: 32ch; }
  .matrix .cell { text-align: center; }
  .matrix .mark { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; font-weight: 600; }
  .matrix .mark i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--text-ghost); display: inline-block; }
  .matrix .mark-yes { color: var(--green); }
  .matrix .mark-yes i { background: var(--green); }
  .matrix .mark-partial { color: var(--amber); }
  .matrix .mark-partial i { background: var(--amber); }
  .matrix .mark-no { color: var(--text-ghost); }
  .matrix .mark-no i { background: var(--text-ghost); opacity: 0.5; }
  .matrix tbody tr:hover { background: hsl(198 95% 52% / 0.03); }
  .matrix .note { display: block; font-weight: 400; color: var(--text-dim); font-size: 0.78rem; margin-top: 0.25rem; line-height: 1.4; }
  .matrix .note a { color: var(--accent); text-decoration: underline; }

  .faqsec { border-top: 1px solid var(--border); }
  .faq { margin: 0 0 2rem; }
  .qa { border-bottom: 1px solid var(--border-subtle); padding: 1.2rem 0; }
  .qa:first-child { padding-top: 0; }
  .qa:last-child { border-bottom: none; }
  .qa dt { font-weight: 700; color: var(--text); font-size: 1rem; margin-bottom: 0.5rem; }
  .qa dd { margin: 0; }
  .qa dd p { margin: 0; color: var(--text-dim); line-height: 1.65; }

  .more { text-align: center; margin-top: 2rem; font-size: 0.9rem; }
  .more a { color: var(--accent); text-decoration: none; }
  .more a:hover { color: var(--accent-glow); text-decoration: underline; }

  .install { border-top: 1px solid var(--border); background: hsl(224 38% 4.5% / 0.4); }
  .post-install { text-align: center; margin-top: 1.4rem; font-size: 0.85rem; color: var(--text-dim); }
  .post-install a { color: var(--accent); text-decoration: underline; }
  .post-install a:hover { color: var(--accent-glow); }

  .pguides { border-top: 1px solid var(--border); }
  .pguide-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .pguide {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    padding: 1.3rem 1.4rem;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .pguide:hover { border-color: var(--accent); box-shadow: 0 0 18px hsl(198 95% 52% / 0.08); }
  .pguide h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--text); }
  .pguide p { margin: 0; color: var(--text-dim); font-size: 0.86rem; line-height: 1.5; }
  @media (max-width: 820px) { .pguide-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .pguide-grid { grid-template-columns: 1fr; } }
</style>
