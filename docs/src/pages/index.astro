---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screenshot from '../components/Screenshot.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Terminal from '../components/Terminal.astro';
import { BASE } from '../utils';
import dashboard from '../assets/screenshots/dashboard.png';
import oscilloscope from '../assets/screenshots/oscilloscope.jpg';

const gh = 'https://github.com/v1nvn/baudflow';

// The marquee differentiators: what makes baudflow a platform, not a cron job.
const pillars = [
  { name: 'oscilloscope', title: 'Live CRT oscilloscope', body: 'Ookla output streamed line-by-line over Erlang ports. Watch the waveform build across the ping → download → upload phases.' },
  { name: 'ping', title: 'Live ping diagnostics', body: 'A dedicated /ping console streams each TCP-connect sample as it lands: cumulative latency, jitter, and loss, updating in real time.' },
  { name: 'cadence', title: 'Adaptive cadence', body: 'A breached schedule runs faster until it recovers, capturing a granular outage timeline without burning bandwidth the rest of the time.' },
  { name: 'heatmap', title: 'Health heatmap', body: 'A GitHub-style calendar wall of speed health: evening congestion and weekend slowdowns jump out at a glance.' },
  { name: 'sla', title: 'SLA & ISP evidence', body: 'Turn raw Mbps into "delivered promised speed 91.3% of the month", the number you can actually take to your ISP.' },
  { name: 'schedules', title: 'Multi-schedule platform', body: 'Hourly against your ISP, every 15 minutes against Cloudflare, a ping every minute. Schedules are data, not config keys.' },
  { name: 'pipeline', title: 'Four-layer alerts', body: 'Event → policy → template → channel. ntfy and webhooks out of the box; a new channel is one module, never a branch.' },
  { name: 'metrics', title: 'Prometheus /metrics', body: 'Eight baudflow_* gauges in hand-rolled text format. Point Grafana at /metrics and it is part of your stack.' },
];

const pains = [
  { q: 'A flaky connection with nothing to show for it', a: 'Every result is stored in full (raw JSON, every field) and rolled up into SLA percentages, heatmaps, and breach timelines you can hand to your ISP.' },
  { q: 'Most outages are not about throughput', a: 'Latency spikes, jitter, and packet loss hit long before bandwidth drops. A first-class ping runner catches what a speed test misses.' },
  { q: 'One cron is a tracker, not a platform', a: 'Multiple schedules, adaptive cadence, health evaluation, and a four-layer alert pipeline turn a cron job into a monitoring platform.' },
];

// Product entity for search + answer engines. No aggregateRating (we have no
// real review data, since faking it would violate Google's policy and harm AEO).
const site = Astro.site ?? new URL(Astro.url.origin);
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Baudflow',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Linux, Docker',
  url: site.href,
  downloadUrl: 'https://github.com/v1nvn/baudflow',
  description:
    'Baudflow is a self-hosted speed test tracker and network monitor: automated Ookla speed tests, live TCP-connect ping diagnostics, adaptive schedules, SLA tracking, and health heatmaps.',
  featureList: [
    'Automated Ookla speed tests on a schedule',
    'Live TCP-connect ping diagnostics with a real-time console',
    'CRT oscilloscope streaming each test as it runs',
    'Adaptive cadence that escalates during a breach',
    'GitHub-style health heatmap',
    'SLA compliance tracking against promised speed',
    'Multi-schedule platform with per-target cron',
    'Four-layer alert pipeline (event → policy → template → channel)',
    'Prometheus /metrics endpoint',
    'ntfy and webhook notifications',
  ],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/license/mit',
  isAccessibleForFree: true,
  author: { '@type': 'Person', name: 'v1nvn', url: 'https://github.com/v1nvn' },
};
---

<BaseLayout
  title="Baudflow: Self-hosted speed test tracker & network monitor"
  description="Baudflow is a self-hosted speed test tracker and network monitor: automated Ookla speed tests, live ping diagnostics, adaptive schedules, SLA tracking, and health heatmaps. A modern, open-source alternative to speedtest-tracker."
  schema={softwareSchema}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <span class="kicker">Self-hosted speed test tracker</span>
      <h1>Know your <em>network.</em><br />Down to the last megabit.</h1>
      <p class="lede">
        Baudflow is a self-hosted speed test tracker that runs automated Ookla
        speed tests and live TCP-connect pings on a schedule, streams every run
        in real time, and turns the results into an actionable picture of your
        connection's health.
      </p>
      <div class="ctas">
        <a class="btn btn-fill" href={`${BASE}#install`}>Get started</a>
        <a class="btn btn-ghost" href={`${BASE}why/`}>Why baudflow?</a>
        <a class="btn btn-ghost" href={gh} rel="noopener">Star on GitHub</a>
      </div>
      <div class="hero-scope"><Screenshot src={oscilloscope} alt="A live Ookla speed test streaming into baudflow's CRT oscilloscope, download phase, building in real time." /></div>
    </div>
  </section>

  <!-- WHY TEASER -->
  <section class="section why-teaser">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why it exists</span>
        <h2>Bandwidth is the easy part. Proof is the hard part.</h2>
        <p>Speedtest gives you a number. Baudflow gives you evidence, patterns, and alerts.</p>
      </div>
      <div class="pain-grid">
        {pains.map((p) => (
          <article class="pain">
            <h3>{p.q}</h3>
            <p>{p.a}</p>
          </article>
        ))}
      </div>
      <p class="more">
        <a href={`${BASE}why/`}>Read the full case for baudflow →</a>
        &nbsp;·&nbsp;
        <a href={`${BASE}compare/speedtest-tracker/`}>Baudflow vs speedtest-tracker →</a>
      </p>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features" class="section">
    <div class="container">
      <div class="section-head">
        <h2>A monitoring platform, not a cron job</h2>
        <p>Live visualization, adaptive schedules, health intelligence, and a real alert pipeline, all self-hosted, all on one screen.</p>
      </div>
      <Screenshot
        src={dashboard}
        alt="The baudflow dashboard, live readout, health heatmap, SLA compliance, and speed history."
      />
      <div class="feature-grid">
        {pillars.map((f) => (
          <FeatureCard name={f.name} title={f.title}>{f.body}</FeatureCard>
        ))}
      </div>
      <p class="more"><a href={`${BASE}features/`}>See the full feature catalog →</a></p>
    </div>
  </section>

  <!-- INSTALL -->
  <section id="install" class="section install">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Up in under a minute</span>
        <h2>Quick start</h2>
        <p>The Ookla CLI is bundled in the image. Bring Postgres and just run the container.</p>
      </div>
      <Terminal />
      <p class="post-install">
        Need more detail? Read the <a href={`${BASE}docs/getting-started/`}>getting started guide</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 3.5rem 0 2.5rem; text-align: center; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.1rem); font-weight: 800; max-width: 18ch; margin: 0.7rem auto 0.9rem; }
  .hero h1 em { font-style: normal; color: var(--cyan); }
  .lede { color: var(--text-dim); max-width: 56ch; margin: 0 auto 1.7rem; }
  .ctas { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2.4rem; }
  .hero-scope { max-width: 680px; margin: 0 auto; }

  .why-teaser { border-top: 1px solid var(--border); }
  .pain-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .pain { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2); padding: 1.3rem 1.4rem; }
  .pain h3 { font-size: 1rem; margin: 0 0 0.5rem; }
  .pain p { margin: 0; color: var(--text-dim); font-size: 0.9rem; line-height: 1.55; }

  .feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2.5rem; }
  @media (max-width: 980px) { .feature-grid { grid-template-columns: repeat(2, 1fr); } .pain-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .feature-grid { grid-template-columns: 1fr; } }

  .more { text-align: center; margin-top: 2rem; font-size: 0.9rem; }
  .more a { color: var(--accent); text-decoration: none; }
  .more a:hover { color: var(--accent-glow); text-decoration: underline; }

  .install { border-top: 1px solid var(--border); background: hsl(224 38% 4.5% / 0.4); }
  .post-install { text-align: center; margin-top: 1.4rem; font-size: 0.85rem; color: var(--text-dim); }
  .post-install a { color: var(--accent); text-decoration: underline; }
  .post-install a:hover { color: var(--accent-glow); text-decoration: underline; }
</style>
