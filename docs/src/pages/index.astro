---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screenshot from '../components/Screenshot.astro';
import Terminal from '../components/Terminal.astro';
import { BASE } from '../utils';
import oscilloscope from '../assets/screenshots/oscilloscope.jpg';

const gh = 'https://github.com/v1nvn/baudflow';

// Product entity for search + answer engines. No aggregateRating (we have no
// real review data, since faking it would violate Google's policy and harm AEO).
// The `featureList` is comprehensive on purpose: it is for AEO/search engines,
// not visible body copy, so the homepage body can stay short.
const site = Astro.site ?? new URL(Astro.url.origin);
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': site.href + '#software',
  name: 'Baudflow',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Linux, Docker',
  url: site.href,
  downloadUrl: 'https://github.com/v1nvn/baudflow',
  description:
    'Baudflow is a self-hosted speed test tracker and network monitor: automated Ookla speed tests, live TCP-connect ping diagnostics, adaptive schedules, SLA tracking, and health heatmaps.',
  featureList: [
    'Automated Ookla speed tests on a schedule',
    'Live TCP-connect ping diagnostics with a real-time console',
    'CRT oscilloscope streaming each test as it runs',
    'Adaptive cadence that escalates during a breach',
    'GitHub-style health heatmap',
    'SLA compliance tracking against promised speed',
    'Multi-schedule platform with per-target cron',
    'Four-layer alert pipeline (event → policy → template → channel)',
    'Prometheus /metrics endpoint',
    'ntfy and webhook notifications',
  ],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  isAccessibleForFree: true,
  logo: {
    '@type': 'ImageObject',
    url: new URL('favicon-96x96.png', site).href,
    width: 96,
    height: 96,
    caption: 'Baudflow logo',
  },
  screenshot: new URL('dashboard.png', site).href,
  sameAs: ['https://github.com/v1nvn/baudflow'],
  knowsAbout: [
    'Internet speed test',
    'Network monitoring',
    'Ookla Speedtest',
    'Latency monitoring',
    'SLA tracking',
  ],
  author: { '@type': 'Person', name: 'v1nvn', url: 'https://github.com/v1nvn' },
};
---

<BaseLayout
  title="Baudflow: Self-hosted speed test tracker & network monitor"
  description="Baudflow is a self-hosted speed test tracker and network monitor: automated Ookla speed tests, live ping diagnostics, adaptive schedules, SLA tracking, and health heatmaps. A modern, open-source alternative to speedtest-tracker."
  schema={softwareSchema}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="kicker">Self-hosted network monitor</span>
        <h1>A self-hosted speed test tracker and network monitor.</h1>
        <p class="lede">
          Baudflow runs automated Ookla speed tests and live TCP-connect pings on
          a schedule, streams every run in real time, and stores the full results
          so you can chart health, SLA, and latency over time.
        </p>
        <div class="ctas">
          <a class="btn btn-fill" href={`${BASE}docs/getting-started/`}>Get started</a>
          <a class="btn btn-ghost" href={gh} rel="noopener">Star on GitHub</a>
        </div>
      </div>
      <div class="hero-scope"><Screenshot src={oscilloscope} alt="A live Ookla speed test streaming into baudflow's CRT oscilloscope, download phase, building in real time." /></div>
    </div>
  </section>

  <!-- INSTALL -->
  <section id="install" class="section install">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Up in under a minute</span>
        <h2>Quick start</h2>
        <p>The Ookla CLI is bundled in the image. Bring Postgres and just run the container.</p>
      </div>
      <Terminal />
      <p class="post-install">
        Need more detail? Read the <a href={`${BASE}docs/getting-started/`}>getting started guide</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 3.5rem 0 2.5rem; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.75rem; align-items: center; }
  .hero-copy { text-align: left; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.1rem); font-weight: 800; max-width: 16ch; margin: 0.7rem 0 0.9rem; }
  .lede { color: var(--text-dim); max-width: 52ch; margin: 0 0 1.7rem; }
  .ctas { display: flex; gap: 0.7rem; justify-content: flex-start; flex-wrap: wrap; }
  .hero-scope { min-width: 0; }
  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-copy { text-align: center; }
    .hero h1 { margin-left: auto; margin-right: auto; }
    .lede { margin-left: auto; margin-right: auto; }
    .ctas { justify-content: center; }
    .hero-scope { max-width: 680px; margin: 0 auto; }
  }

  .install { border-top: 1px solid var(--border); background: hsl(224 38% 4.5% / 0.4); }
  .post-install { text-align: center; margin-top: 1.4rem; font-size: 0.85rem; color: var(--text-dim); }
  .post-install a { color: var(--accent); text-decoration: underline; }
  .post-install a:hover { color: var(--accent-glow); text-decoration: underline; }
</style>
