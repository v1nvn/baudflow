---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE } from '../utils';
import { faqs } from '../data/faq';

// FAQPage no longer earns a SERP rich result (Google retired it for all sites
// May 7, 2026), but the markup is still a strong signal for AI Overviews /
// answer-engine entity resolution, which is the AEO goal here.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="FAQ · Baudflow"
  description="Common questions about baudflow: self-hosting, requirements, Postgres, auth, the ping runner, data retention, Grafana, and the roadmap."
  schema={faqSchema}
>
  <section class="hero">
    <div class="container narrow">
      <span class="kicker">FAQ</span>
      <h1>Frequently asked questions</h1>
      <p class="lede">Still wondering something? The <a href={`${BASE}docs/`}>docs</a> go deeper, see how baudflow <a href={`${BASE}compare/speedtest-tracker/`}>compares to speedtest-tracker</a>, and issues live on <a href="https://github.com/v1nvn/baudflow" rel="noopener">GitHub</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <dl class="faq">
        {faqs.map((f) => (
          <div class="qa">
            <dt>{f.q}</dt>
            <dd><p>{f.a}</p></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 3.5rem 0 0.5rem; text-align: center; }
  .hero h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 800; margin: 0.6rem 0 0.7rem; }
  .lede { color: var(--text-dim); margin: 0 auto; }
  .lede a { color: var(--accent); text-decoration: none; }
  .lede a:hover { text-decoration: underline; }
  .narrow { max-width: 50rem; }

  .faq { margin: 2rem 0 0; }
  .qa { border-bottom: 1px solid var(--border-subtle); padding: 1.3rem 0; }
  .qa:first-child { padding-top: 0; }
  .qa dt { font-weight: 700; color: var(--text); font-size: 1.02rem; margin-bottom: 0.5rem; }
  .qa dd { margin: 0; }
  .qa dd p { margin: 0; color: var(--text-dim); line-height: 1.65; }
</style>
