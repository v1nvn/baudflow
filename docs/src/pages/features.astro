---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screenshot from '../components/Screenshot.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { BASE, asset } from '../utils';

const groups = [
  {
    kicker: 'Real-time visibility',
    title: 'Watch every test happen',
    lead: 'Baudflow streams progress over PubSub as it runs — no spinner, no polling, no waiting for a result to land.',
    items: [
      { icon: '∿', title: 'Live CRT oscilloscope', body: 'Ookla NDJSON streamed line-by-line over Erlang ports, with phase tracking and phosphor afterglow as the waveform builds.' },
      { icon: '◌', title: 'Live ping diagnostics', body: 'A dedicated /ping page streams each TCP-connect sample — cumulative avg, jitter, low/high, and loss, updating live.' },
      { icon: '▶', title: 'Manual runs + history', body: 'Trigger a test instantly, or let the scheduler run. Every run is logged with success, failure, or timeout status.' },
      { icon: '⟡', title: 'Per-result drill-down', body: 'Ping, jitter, packet loss, server, ISP — every measurement fully inspectable, with the raw JSON preserved.' },
    ],
  },
  {
    kicker: 'Health intelligence',
    title: 'From numbers to a verdict',
    lead: 'Health is derived just-in-time from thresholds, never stored — so changing your mode re-derives every view instantly.',
    items: [
      { icon: '↯', title: 'Adaptive cadence', body: 'A breached schedule switches to a faster escalated cron until it recovers — outage detail without wasted bandwidth.' },
      { icon: '≈', title: 'Auto / absolute / off', body: 'Auto judges against your own rolling baseline (zero-config); absolute uses fixed Mbps/ms; off disables verdicts.' },
      { icon: '∱', title: 'Breach streaks & transitions', body: 'Healthy → breach → recovered transitions, tracked atomically per schedule and surfaced to alerts and escalation.' },
      { icon: '∑', title: 'SLA compliance', body: 'The percentage of tests that met your promised speeds — "delivered 91.3% of the month" instead of a bare Mbps number.' },
      { icon: '▦', title: 'Health heatmap', body: 'A GitHub-style calendar wall revealing evening congestion, weekend slowdowns, and recurring outages at a glance.' },
    ],
  },
  {
    kicker: 'Alerts that don\'t cry wolf',
    title: 'A pipeline, not a pile of if-statements',
    lead: 'Event → policy → template → channel. Each layer is one concern; the policy decides whether to notify before any work is done.',
    items: [
      { icon: '⇄', title: 'Four-layer pipeline', body: 'A pure policy module, a per-channel template renderer, and a channel behaviour. Adding a channel is one module.' },
      { icon: '≠', title: 'Breach-streak gating', body: 'A breach fires exactly once, when the streak first reaches your threshold — not on every re-check. Less noise.' },
      { icon: '↺', title: 'Recovery & failure alerts', body: 'Get notified when service recovers, and when a run outright fails — not only on degradation.' },
      { icon: '✉', title: 'ntfy', body: 'Push to a self-hosted or hosted ntfy.sh topic, wired through application env.' },
      { icon: '⌁', title: 'Webhooks + templates', body: 'POST JSON to Home Assistant, Grafana, n8n, or a custom endpoint, with an editable EEx body. Blank URL disables it.' },
    ],
  },
  {
    kicker: 'Fits your stack',
    title: 'Born for the homelab',
    lead: 'Standard interfaces, plain text, no lock-in. Baudflow slots into the observability setup you already run.',
    items: [
      { icon: '◔', title: 'Prometheus /metrics', body: 'Eight baudflow_* gauges in hand-rolled text format, NaN for stale values — scrape it like any exporter.' },
      { icon: '♥', title: '/health endpoint', body: 'A lightweight liveness check for Uptime Kuma or a Kubernetes probe.' },
      { icon: '▣', title: 'Embeddable heatmap', body: 'A chrome-less /heatmap/embed for iframing into Home Assistant or Grafana dashboards.' },
      { icon: '💾', title: 'Raw JSON retention', body: 'The full result is stored on every measurement — derived views are cheap, raw data is sacred. Pruned by retention.' },
      { icon: '🐳', title: 'Multi-arch Docker', body: 'A non-root, Ookla-bundled image for amd64 and arm64. One container, one Postgres.' },
    ],
  },
];
---

<BaseLayout title="Features — Baudflow" description="Live speed and ping visualization, adaptive schedules, health intelligence, a four-layer alert pipeline, and Prometheus metrics — self-hosted.">
  <section class="hero">
    <div class="container">
      <span class="kicker">Features</span>
      <h1>Everything a flaky connection can throw at you</h1>
      <p class="lede">Live visualization, adaptive schedules, health intelligence, and a real alert pipeline — all self-hosted, all in one Phoenix LiveView app.</p>
    </div>
  </section>

  <section class="section showcase">
    <div class="container">
      <Screenshot
        src={asset('screenshots/dashboard.png')}
        alt="The baudflow dashboard — live readout, health heatmap, SLA compliance, and speed history."
        url="baudflow.v1n.space"
        wide
      />
      <div class="shot-duo">
        <Screenshot
          src={asset('screenshots/oscilloscope.jpg')}
          alt="A live Ookla speed test streaming into the CRT oscilloscope — download phase, 516 Mbps and climbing."
          url="baudflow.v1n.space"
        />
        <Screenshot
          src={asset('screenshots/ping.png')}
          alt="The /ping page with a live per-sample diagnostics panel — average latency, jitter, loss, and a bar for each sample."
          url="baudflow.v1n.space"
        />
      </div>
      <div class="shot-duo">
        <Screenshot
          src={asset('screenshots/heatmap.png')}
          alt="The health heatmap — a calendar wall of daily speed-test health."
          url="baudflow.v1n.space"
        />
        <Screenshot
          src={asset('screenshots/schedules.png')}
          alt="The schedules table — multiple cron schedules, each with its own test type and escalation state."
          url="baudflow.v1n.space"
        />
      </div>
    </div>
  </section>

  {groups.map((g) => (
    <section class="section group">
      <div class="container">
        <div class="group-head">
          <span class="kicker">{g.kicker}</span>
          <h2>{g.title}</h2>
          <p>{g.lead}</p>
        </div>
        <div class="card-grid">
          {g.items.map((f) => (
            <FeatureCard icon={f.icon} title={f.title}>{f.body}</FeatureCard>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section cta">
    <div class="container cta-inner">
      <h2>Run it in under a minute</h2>
      <p>One container, one Postgres, the Ookla CLI bundled in.</p>
      <div class="ctas">
        <a class="btn btn-fill" href={`${BASE}#install`}>▶ Get started</a>
        <a class="btn btn-ghost" href={`${BASE}docs/`}>Read the docs</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 3.5rem 0 1rem; text-align: center; }
  .hero h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; max-width: 22ch; margin: 0.7rem auto 0.9rem; }
  .lede { color: var(--text-dim); max-width: 60ch; margin: 0 auto; }
  .showcase { padding-top: 2rem; padding-bottom: 1rem; }
  .shot-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  @media (max-width: 760px) { .shot-duo { grid-template-columns: 1fr; } }

  .group { border-top: 1px solid var(--border); }
  .group-head { max-width: 44rem; margin-bottom: 2rem; }
  .group-head h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 800; margin: 0.4rem 0 0.6rem; }
  .group-head p { color: var(--text-dim); margin: 0; }
  .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  @media (max-width: 820px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .card-grid { grid-template-columns: 1fr; } }

  .cta { border-top: 1px solid var(--border); text-align: center; }
  .cta-inner h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin: 0 0 0.5rem; }
  .cta-inner p { color: var(--text-dim); margin: 0 0 1.4rem; }
  .ctas { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; }
</style>
